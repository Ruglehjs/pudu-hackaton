# Configuración opcional del puente. Copia este archivo a .env.
PUDU_BATTLE_PORT=18425
# GEMINI_API_KEY=
# GOOGLE_CLOUD_PROJECT=              # Proyecto con Vertex AI y credenciales ADC
# Si el proveedor retiró 2.5 Flash, el puente prueba gemini-3.5-flash-lite.
# Para fijar un único modelo (por ejemplo en Vertex), descomenta esta línea.
# PUDU_BATTLE_MODEL=gemini-3.5-flash-lite
# PUDU_SPRITE_MODEL=gemini-2.5-flash-image
